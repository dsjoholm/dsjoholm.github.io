#!/bin/bash
# Start a new post:
#
#   newpost "My trip to Lyon"          (the Terminal shortcut, from anywhere)
#   bin/new-post "My trip to Lyon"     (the same, from the site folder)
#
# Creates _posts/<today>-my-trip-to-lyon.md (from _drafts/post-template.md,
# with the title and today's date filled in) and its photo folder
# assets/img/posts/my-trip-to-lyon/, then opens the folder in Finder and
# the post in your text editor.
#
# For a title with no Latin letters (e.g. Chinese), give a short name too:
#   newpost "台北之旅" taipei-trip

set -e
cd "$(dirname "$0")/.."

title="$1"
if [ -z "$title" ]; then
  echo 'Usage: newpost "Title of the post" [short-name]'
  exit 1
fi

# The short name: from the title, lowercase, accents removed, dashes for spaces
slug="$2"
if [ -z "$slug" ]; then
  slug=$(/usr/bin/python3 -c '
import re, sys, unicodedata
t = unicodedata.normalize("NFKD", sys.argv[1])
t = "".join(c for c in t if not unicodedata.combining(c)).lower()
print(re.sub(r"[^a-z0-9]+", "-", t).strip("-"))' "$title")
fi
if [ -z "$slug" ]; then
  echo "Couldn't make a short name from that title. Add one, e.g.:"
  echo "  newpost \"$title\" my-short-name"
  exit 1
fi

today=$(date +%Y-%m-%d)
post="_posts/$today-$slug.md"
photos="assets/img/posts/$slug"

if ls _posts/*-"$slug".md >/dev/null 2>&1; then
  echo "A post named \"$slug\" already exists: $(ls _posts/*-"$slug".md)"
  echo "Pick another title, or give a different short name as a second word."
  exit 1
fi

# Copy the template, with this title (quotes escaped) and today's date
safe_title=$(printf '%s' "$title" | sed 's/"/\\"/g')
awk -v t="$safe_title" -v d="$today" '
  /^title: / && !done_t { print "title: \"" t "\""; done_t = 1; next }
  /^date: /  && !done_d { print "date: " d; done_d = 1; next }
  { print }
' _drafts/post-template.md > "$post"

mkdir -p "$photos"

echo "Created:"
echo "  the post:      $post"
echo "  photo folder:  $photos/"
echo
echo "Put photos in the folder, then use them in the post by file name:"
echo "  ![A caption](photo.jpg)"

open "$photos"      # Finder window for dragging photos in
open -t "$post"     # the post in your text editor
