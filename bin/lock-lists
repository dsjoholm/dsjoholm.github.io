#!/usr/bin/env ruby
# Locked lists: lists that only open with a password.
#
# The real list lives only on this Mac, in _notes/locked/<name>.md (the
# _notes folder is never committed or published). It looks like any other
# list, plus a password line at the top:
#
#   ---
#   title: Places I've lived
#   description: Every address, in order.
#   updated: 2026-11-17
#   password: the password
#   ---
#   - 23 rue Bezout, Paris - a note
#
# This turns each one into _lists/<name>.md, which holds the title,
# description and date in plain text but the list itself only scrambled
# (AES-256 encryption, with a key made from the password). The site shows
# the title and a password box; the right password unscrambles the list in
# the visitor's browser. The list and the password never leave this Mac
# in readable form.
#
# Runs by itself on every `git commit` (see .githooks/pre-commit), and only
# rewrites a locked list when its text, title, date or password changed.
# To run it by hand:   bin/lock-lists

ROOT = File.expand_path("..", __dir__)
ENV["BUNDLE_GEMFILE"] ||= File.join(ROOT, "Gemfile")
require "bundler/setup"
require "kramdown"
require "openssl"
require "base64"
require "yaml"
require "date"
require_relative "../_plugins/list_notes"

SOURCE = File.join(ROOT, "_notes", "locked")
TARGET = File.join(ROOT, "_lists")
ITERATIONS = 600_000   # makes each password guess slow

def key_for(password, salt, iterations)
  OpenSSL::KDF.pbkdf2_hmac(password.to_s, salt: salt, iterations: iterations, length: 32, hash: "sha256")
end

def encrypt(text, password)
  salt = OpenSSL::Random.random_bytes(16)
  iv = OpenSSL::Random.random_bytes(12)
  cipher = OpenSSL::Cipher.new("aes-256-gcm").encrypt
  cipher.key = key_for(password, salt, ITERATIONS)
  cipher.iv = iv
  data = cipher.update(text) + cipher.final + cipher.auth_tag   # the browser expects the tag at the end
  { "iterations" => ITERATIONS, "salt" => Base64.strict_encode64(salt),
    "iv" => Base64.strict_encode64(iv), "data" => Base64.strict_encode64(data) }
end

def decrypt(locked, password)
  raw = Base64.strict_decode64(locked["data"])
  cipher = OpenSSL::Cipher.new("aes-256-gcm").decrypt
  cipher.key = key_for(password, Base64.strict_decode64(locked["salt"]), locked["iterations"])
  cipher.iv = Base64.strict_decode64(locked["iv"])
  cipher.auth_tag = raw[-16..]
  (cipher.update(raw[0...-16]) + cipher.final).force_encoding("UTF-8")
rescue StandardError
  nil
end

def read_front(path)
  text = File.read(path, encoding: "UTF-8")
  return [{}, text] unless text =~ /\A---\s*\n(.*?\n)---\s*\n/m
  [YAML.safe_load(Regexp.last_match(1), permitted_classes: [Date]) || {}, Regexp.last_match.post_match]
end

changed = []
Dir.glob(File.join(SOURCE, "*.md")).sort.each do |src|
  name = File.basename(src)
  front, body = read_front(src)
  password = front.delete("password").to_s
  if password.empty?
    warn "lock-lists: #{name} has no password line, so it was left unpublished"
    next
  end

  html = ListNotes.apply(Kramdown::Document.new(body).to_html)
  out = File.join(TARGET, name)
  public_front = front.merge("layout" => "list")

  # Leave it alone if nothing changed (every lock scrambles differently,
  # so re-locking would make a needless change on every commit)
  if File.exist?(out)
    old_front, = read_front(out)
    old_locked = old_front.delete("locked")
    next if old_locked && old_front == public_front && decrypt(old_locked, password) == html
  end

  File.write(out, <<~MD)
    #{public_front.merge("locked" => encrypt(html, password)).to_yaml.chomp}
    ---
    <!-- A locked list: made by bin/lock-lists from _notes/locked/#{name}. Edit that file, not this one. -->
  MD
  changed << out
  puts "lock-lists: locked #{File.join("_lists", name)}"
end

system("git", "-C", ROOT, "add", *changed) if ARGV.include?("--staged") && changed.any?
